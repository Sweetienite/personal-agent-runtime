{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal Agent Runtime task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "description", "risk", "idempotency_key"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1, "maxLength": 20000},
    "role": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "worker": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "allowed_paths": {
      "type": "array", "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "criteria": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "checks": {"type": "array", "maxItems": 10, "items": {"$ref": "#/definitions/check"}}
      }
    },
    "dependencies": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*-[0-9]{4,}$"}
    },
    "ad_hoc": {"type": "boolean"},
    "timeouts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "startup": {"type": "number", "minimum": 1, "maximum": 600},
        "idle": {"type": "number", "minimum": 1, "maximum": 3600},
        "total": {"type": "number", "minimum": 1, "maximum": 7200}
      }
    },
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
  },
  "definitions": {
    "check": {
      "type": "object", "additionalProperties": false, "required": ["name", "argv"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "timeout": {"type": "number", "minimum": 1, "maximum": 600},
        "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    }
  }
}
