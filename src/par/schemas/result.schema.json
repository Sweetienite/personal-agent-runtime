{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal Agent Runtime result envelope",
  "description": "Everything under 'tests' and 'boundary' is measured by the Kernel. 'summary' is the Worker's own statement and is never verified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "attempt", "provider", "worker", "model_requested", "model_observed",
               "terminal_state", "outcome", "summary", "summary_verified", "evidence", "diff_artifact", "diff_stat",
               "tests", "boundary", "remaining_issues", "next_action", "handoff_usable", "partial",
               "started_at", "ended_at"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*-[0-9]{4,}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "provider": {"type": "string", "minLength": 1},
    "worker": {"type": "string", "minLength": 1},
    "model_requested": {"type": "string", "minLength": 1},
    "model_observed": {"type": ["string", "null"]},
    "terminal_state": {"enum": ["SUCCESS", "ERROR", "CANCELED", "NONE"]},
    "outcome": {"enum": ["completed", "failed", "interrupted", "canceled", "orphaned"]},
    "failure_class": {"type": ["string", "null"]},
    "stage": {"type": ["string", "null"]},
    "summary": {"type": "string", "maxLength": 1200},
    "summary_verified": {"const": false},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "diff_artifact": {"type": ["string", "null"]},
    "diff_stat": {
      "type": "object", "additionalProperties": false, "required": ["files", "additions", "deletions"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "additions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0}
      }
    },
    "tests": {"type": "array", "items": {"$ref": "#/definitions/test"}},
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["violations", "sensitive", "paths"],
      "properties": {
        "violations": {"type": "integer", "minimum": 0},
        "sensitive": {"type": "integer", "minimum": 0},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "usage": {"type": ["object", "null"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "remaining_issues": {"type": "array", "items": {"type": "string"}},
    "next_action": {"enum": ["review", "retry", "approve", "investigate", "none"]},
    "handoff_usable": {"type": "boolean"},
    "partial": {"type": "boolean"},
    "started_at": {"type": "string", "minLength": 1},
    "ended_at": {"type": "string", "minLength": 1}
  },
  "definitions": {
    "test": {
      "type": "object", "additionalProperties": false, "required": ["name", "status", "exit_code", "duration_s"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "TIMEOUT", "ERROR"]},
        "exit_code": {"type": ["integer", "null"]},
        "duration_s": {"type": "number", "minimum": 0},
        "log": {"type": ["string", "null"]}
      }
    }
  }
}
