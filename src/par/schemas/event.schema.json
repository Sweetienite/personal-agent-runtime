{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal Agent Runtime ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ts", "task_id", "attempt", "type", "from_status", "to_status", "reason", "data"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "task_id": {"type": ["string", "null"]},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "type": {"type": "string", "pattern": "^[A-Z][A-Z_]*$"},
    "from_status": {"type": ["string", "null"]},
    "to_status": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "data": {"type": "object"}
  }
}
